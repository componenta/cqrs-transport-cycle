{
    "name": "componenta/cqrs-transport-cycle",
    "description": "Cycle Database transport for Componenta CQRS commands",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "componenta/cqrs-transport": "^1.0 || ^2.0 || ^3.0.1 || ^4.0",
        "cycle/database": "^2.21"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max"
    }
}
