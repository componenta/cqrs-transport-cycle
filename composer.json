{
    "name": "componenta/cqrs-transport-cycle",
    "description": "Cycle Database transport for Componenta CQRS commands",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "componenta/cqrs-transport": "^1.0",
        "cycle/database": "^2.15"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
